# Vercel deploys two services from the repo root (vercel.json): the web app (apps/web, which imports the API contract
# from packages/contracts) and the API bundle generated by scripts/vercel/build_api.py (build/vercel-api).
# Upload nothing else: no raw data, models, local storage, local packs or Python sources outside the bundle.
/*
!/vercel.json
!/apps
/apps/*
!/apps/web
!/packages
!/build
/build/*
!/build/vercel-api
/apps/web/node_modules
/apps/web/.next
/apps/web/.next-build
/apps/web/test-results
/apps/web/tsconfig.tsbuildinfo
