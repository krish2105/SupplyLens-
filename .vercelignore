# Vercel deploys two services from the repo root (vercel.json): the web app (apps/web, which imports the API contract
# from packages/contracts) and the API service in deploy/vercel-api, whose buildCommand stages the API code from
# services/, ml/, optimisation/, artifacts/ (published metrics) and evaluations/ (study registry).
# Upload nothing else: no raw data, models, local storage, local packs or private files.
/*
!/vercel.json
!/apps
/apps/*
!/apps/web
!/packages
!/deploy
!/scripts
/scripts/*
!/scripts/vercel
!/services
!/ml
!/optimisation
!/artifacts
!/evaluations
/evaluations/*
!/evaluations/study_registry.json
!/uv.lock
/apps/web/node_modules
/apps/web/.next
/apps/web/.next-build
/apps/web/test-results
/apps/web/tsconfig.tsbuildinfo
/deploy/vercel-api/services
/deploy/vercel-api/ml
/deploy/vercel-api/optimisation
/deploy/vercel-api/artifacts
/deploy/vercel-api/evaluations
**/__pycache__
