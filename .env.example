# Copy to .env for local development. Dev-only credentials; never use in a shared environment.
SUPPLYLENS_DATABASE_URL=postgresql+psycopg://supplylens_app:supplylens_app_dev@localhost:5432/supplylens
SUPPLYLENS_ADMIN_DATABASE_URL=postgresql+psycopg://supplylens_owner:supplylens_owner_dev@localhost:5432/supplylens
SUPPLYLENS_STORAGE_DIR=storage
SUPPLYLENS_OLLAMA_URL=http://localhost:11434
SUPPLYLENS_EMBED_MODEL=bge-m3:567m
SUPPLYLENS_SESSION_SECRET=dev-only-change-me
SUPPLYLENS_DEV_AUTH=true
