{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web/", "framework": "nextjs" },
    "api": {
      "root": "build/vercel-api/",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": { "index.py": { "maxDuration": 300 } }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
